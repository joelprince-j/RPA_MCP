{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/schemas/crawler-flow.json",
  "title": "Web Crawler Flow Configuration",
  "description": "Schema for defining web crawling flows with authentication, actions, and output configurations",
  "type": "object",
  "required": ["flowId", "name", "startUrl", "actions", "return"],
  "properties": {
    "flowId": {
      "type": "string",
      "description": "Unique identifier for the flow",
      "pattern": "^[a-zA-Z0-9_-]+$"
    },
    "name": {
      "type": "string",
      "description": "Human-readable name of the flow",
      "minLength": 1,
      "maxLength": 255
    },
    "description": {
      "type": "string",
      "description": "Description of what this flow does"
    },
    "startUrl": {
      "type": "string",
      "description": "Starting URL for the crawling flow",
      "format": "uri"
    },
    "auth": {
      "type": "object",
      "description": "Authentication configuration",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Whether authentication is enabled"
        },
        "url": {
          "type": "string",
          "description": "Authentication endpoint URL",
          "format": "uri"
        },
        "steps": {
          "type": "array",
          "description": "Authentication steps to execute",
          "items": {
            "$ref": "#/definitions/actionStep"
          }
        }
      }
    },
    "actions": {
      "type": "array",
      "description": "List of actions to perform during crawling",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/actionStep"
      }
    },
    "return": {
      "type": "object",
      "description": "Return and output configuration",
      "required": ["format", "fields", "outputs"],
      "properties": {
        "format": {
          "type": "string",
          "enum": ["json", "xml", "csv", "text"],
          "description": "Primary return format"
        },
        "fields": {
          "type": "array",
          "description": "Fields to extract and return",
          "items": {
            "type": "string"
          }
        },
        "outputs": {
          "type": "array",
          "description": "Output destinations and configurations",
          "items": {
            "oneOf": [
              { "$ref": "#/definitions/s3Output" }
            ]
          }
        }
      }
    },
    "errorHandling": {
      "type": "object",
      "description": "Error handling configuration",
      "properties": {
        "retryOnFailure": {
          "type": "boolean",
          "description": "Whether to retry on failure"
        },
        "maxRetries": {
          "type": "integer",
          "description": "Maximum number of retry attempts",
          "minimum": 0,
          "maximum": 10
        },
        "retryDelay": {
          "type": "integer",
          "description": "Delay between retries in milliseconds",
          "minimum": 0
        },
        "captureScreenshotOnError": {
          "type": "boolean",
          "description": "Whether to capture screenshots on errors"
        },
        "continueOnError": {
          "type": "boolean",
          "description": "Whether to continue execution on error"
        }
      }
    }
  },
  "definitions": {
    "actionStep": {
      "type": "object",
      "required": ["stepId", "actionType"],
      "properties": {
        "stepId": {
          "type": "integer",
          "description": "Unique step identifier",
          "minimum": 1
        },
        "actionType": {
          "type": "string",
          "enum": ["click", "type", "navigate", "wait", "scroll", "extract", "screenshot", "select", "hover", "submit"],
          "description": "Type of action to perform"
        },
        "params": {
          "type": "object",
          "properties": {
            "timeout": {
              "type": "integer",
              "description": "Timeout in milliseconds",
              "minimum": 0
            },
            "elementId": {
              "type": "string",
              "description": "Element identifier"
            },
            "selectors": {
              "type": "object",
              "properties": {
                "css": {
                  "type": "string",
                  "description": "CSS selector"
                },
                "xpath": {
                  "type": "string",
                  "description": "XPath selector"
                },
                "text": {
                  "type": "string",
                  "description": "Text-based selector"
                }
              }
            },
            "value": {
              "type": "string",
              "description": "Value to input (for type actions)"
            },
            "url": {
              "type": "string",
              "description": "URL to navigate to",
              "format": "uri"
            }
          }
        },
        "description": {
          "type": "string",
          "description": "Human-readable description of the step"
        }
      }
    }
  }
}